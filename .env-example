STARCOMMUNITY_PUBLIC_KEY_URL=https://api.test.starcommunity.app/.well-known/webhooks.key
AURORA_URL=http://localhost:3000
AURORA_API_KEY=beep

# Handler names as returned by GET /api/handler/screen (id field)
AURORA_SCREEN_HANDLER_CAROUSEL=CarouselPosterHandler
AURORA_SCREEN_HANDLER_STATIC_POSTER=StaticPosterHandler

# Static poster IDs (from GET /api/handler/screen/poster/static/items) for each non-open state
AURORA_POSTER_LAST_CALL_ID=4
AURORA_POSTER_CLOSED_ID=3
AURORA_POSTER_EVACUATION_ID=3 